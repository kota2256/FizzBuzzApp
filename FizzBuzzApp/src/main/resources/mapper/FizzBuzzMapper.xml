<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- Mapperとxmlのマッピング -->
<mapper namespace="com.example.repository.FizzBuzzMapper">

	<!-- 1件登録 -->
	<insert id="insertOne">
		insert into input_num(input_num)
		values(#{inputNum})
	</insert>
	
	<!-- 履歴取得 -->
	<select id="findMany" resultType="InputNum">
		SELECT *
		FROM input_num
		ORDER BY created_at DESC
		LIMIT 3 OFFSET 1 
	</select>
	
</mapper>